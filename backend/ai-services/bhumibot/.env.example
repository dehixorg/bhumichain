# BhumiBot AI Service Configuration (Port 8015)
BHUMIBOT_PORT=8015
BHUMIBOT_ENV=development

# LLM Configuration
BHUMIBOT_MODEL_NAME=gpt-4o
BHUMIBOT_TEMPERATURE=0.2
BHUMIBOT_MAX_TOKENS=2048

# OpenAI API Key (Optional — fallback engine active if unset)
BHUMIBOT_OPENAI_API_KEY=
BHUMIBOT_OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI Credentials (Optional)
BHUMIBOT_AZURE_OPENAI_ENDPOINT=
BHUMIBOT_AZURE_OPENAI_KEY=
BHUMIBOT_AZURE_OPENAI_DEPLOYMENT=gpt-4o
BHUMIBOT_AZURE_OPENAI_API_VERSION=2024-02-15-preview
