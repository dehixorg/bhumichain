# ==============================================================================
# BHUMICHAIN MASTER LOCAL ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Instructions for your teammate running locally (`localhost`) & working on Nyaya AI:
# Copy the respective sections below into their target files inside the repository.
# ==============================================================================


# ==============================================================================
# SECTION 1: FRONTEND PORTAL
# Target File -> frontend/web-portal/.env.local
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Use mock blockchain mode locally so you do not need the remote Azure Fabric VM running
NEXT_PUBLIC_FABRIC_MODE=mock

# Map settings (Gautam Buddha Nagar / Dadri tehsil center)
NEXT_PUBLIC_MAP_CENTER_LAT=28.5706
NEXT_PUBLIC_MAP_CENTER_LNG=77.5413
NEXT_PUBLIC_MAP_ZOOM=12
NEXT_PUBLIC_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png


# ==============================================================================
# SECTION 2: API GATEWAY
# Target File -> backend/api-gateway/.env
# ==============================================================================
PORT=4000
NODE_ENV=development
JWT_SECRET=bhumichain-local-dev-secret-key-32-chars
JWT_EXPIRY=8h
AADHAAR_SALT=bhumichain-local-aadhaar-salt

# Fabric Blockchain Mode ('mock' locally unless connected via VPN/SSH tunnel to Fabric VM)
FABRIC_MODE=mock

# Frontend CORS
FRONTEND_URL=http://localhost:3000

# AI Services Microservice URLs (Points API Gateway directly to local Nyaya AI on port 8012)
NYAYA_AI_URL=http://localhost:8012
RECORD_SCAN_URL=http://localhost:8010
COPARCENARY_URL=http://localhost:8011
SETTLE_URL=http://localhost:8013

# Optional Notifications (Set to mock/true locally)
TELEGRAM_MOCK=true


# ==============================================================================
# SECTION 3: NYAYA AI MICROSERVICE ⭐ (Where your teammate will develop)
# Target File -> backend/ai-services/nyaya-ai/.env
# ==============================================================================
# ─── Claude / Anthropic API Key (Required for real AI responses) ──────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service Mode: 'claude' for real LLM queries, or 'mock' to test without API credits
NYAYA_MODE=claude

# Service Port & CORS
PORT=8012
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
API_GATEWAY_URL=http://localhost:4000

# Optional AWS DynamoDB (for daily citizen/officer token limits if testing real rate-limiting)
# If left blank, Nyaya AI falls back to in-memory dictionary token tracking locally
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
DYNAMO_TABLE_TOKENS=bhumichain-tokens
